# =============================================================================
# cad-boq-tool 环境变量模板
# 复制为 .env 后填值；切勿提交 .env（含密钥）
# 注：本仓库用 env.example（无前导点）以避开 .env* 权限保护；
# 部署时手工 `cp env.example .env` 后编辑
# =============================================================================

# ---------- 应用 ----------
APP_ENV=dev                          # dev / staging / prod
APP_HOST=0.0.0.0
APP_PORT=8521
APP_BASE_URL=http://localhost:8521
LOG_DIR=/var/log/cad-boq             # Linux 部署；Windows 改 D:\cad-boq\logs
LOG_LEVEL=INFO

# ---------- 数据库：PostgreSQL 16 + PostGIS 3.4 ----------
# async 驱动（webapi 运行时用）
DATABASE_URL=postgresql+asyncpg://cadboq:cadboq_dev@localhost:5432/cadboq
# sync 驱动（alembic 迁移 + sqlite_to_pg.py 用）
DATABASE_URL_SYNC=postgresql+psycopg://cadboq:cadboq_dev@localhost:5432/cadboq
# 旧 SQLite 数据迁移源（一次性使用，迁移完成后可置空）
SQLITE_BACKUP_PATH=/c/Users/Solomon/.cad-boq-tool/projects.db

# ---------- 鉴权（RuoYi 风格 RBAC，当前单用户免登录） ----------
AUTH_MODE=no_login                   # no_login（Phase 0）/ login（未来）
SECRET_KEY=change-me-in-production-please-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ---------- ODA File Converter（B5 S1 DWG 无头转换） ----------
ODA_FILE_CONVERTER=/usr/local/bin/ODAFileConverter
ODA_INSTALL_HINTS=/usr/local/ODA,/opt/ODA
ODA_TIMEOUT=300
ACCORECONSOLE_PATH=

# ---------- LLM 后端（5 个，当前默认 Ollama） ----------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-vl-max-0809
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_EMBEDDING_MODEL=
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BACKEND=
LLM_QUALITY_THRESHOLD=0.7
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4000

# ---------- 存储（解析缓存 + 嵌入缓存 + B3 块几何） ----------
DRAWING_CACHE_DIR=/var/lib/cad-boq/drawing_cache
EMBEDDING_CACHE_DIR=/var/lib/cad-boq/embedding_cache
BLOCK_GEOMETRY_DIR=/var/lib/cad-boq/block_geometry

# ---------- 文件上传 ----------
MAX_UPLOAD_SIZE=209715200            # 200MB
ALLOWED_EXTENSIONS=.dwg,.dxf,.xlsx,.xls,.json,.csv

# ---------- CORS（Phase 0 默认 localhost） ----------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8521,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# ---------- 测试数据通路（P0-22 占位） ----------
TEST_DATA_REGISTRY_PATH=/var/lib/cad-boq/test_data_registry.json
